# Prefer Backend/.env (one shared file for Python + Node).
# See Backend/.env.example for the full list and correct defaults.

JWT_SECRET=dev-only-secret-change-me-before-production-0123456789
MONGO_URL=mongodb://localhost:27017
MONGO_DB=webvector
REDIS_URL=redis://localhost:6379/0
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=web-vector-node
KAFKA_GROUP_ID=web-vector-node-replies
KAFKA_TOPIC_INCOMING=whatsapp.incoming
KAFKA_TOPIC_OUTGOING=whatsapp.outgoing
FASTIFY_PORT=3001
FASTIFY_CORS_HOST_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
FASTIFY_NODE_ENV=development
