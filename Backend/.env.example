# ============================================================================
# Web Vector - ONE shared .env for Python (FastAPI + Kafka worker) and Node (Fastify + Baileys)
#   cp Backend/.env.example Backend/.env      (then fill in the 3 things marked  <-- FILL)
# The defaults already match docker-compose.yml.
# ============================================================================

# ---- Shared secret: Python signs the login cookie with it, Node verifies it. MUST be identical. ----
JWT_SECRET=dev-only-secret-change-me-before-production-0123456789      # <-- FILL (python -c "import secrets; print(secrets.token_urlsafe(48))")
DEV_MODE=true                                     # false in production (Secure cookies)

# ---- Postgres (Python) ----
DATABASE_URL=postgresql+asyncpg://webvector:webvector@localhost:5432/webvector

# ---- Redis (Python: OTP codes) ----
REDIS_URL=redis://localhost:6379/0

# ---- MongoDB (Node: WhatsApp login data per user) ----
MONGO_URL=mongodb://localhost:27017
MONGO_DB=webvector

# ---- Kafka (Node <-> Python) ----
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=web-vector-node
KAFKA_GROUP_ID=web-vector-node-replies            # Node's consumer group
KAFKA_WORKER_GROUP_ID=web-vector-python-worker    # Python's consumer group
KAFKA_TOPIC_INCOMING=whatsapp.incoming            # Node   -> Python
KAFKA_TOPIC_OUTGOING=whatsapp.outgoing            # Python -> Node
EVENT_MAX_AGE_SECONDS=900                         # older events are dropped, never replayed to real people

# ---- LLM: any OpenAI-compatible API (default = OpenRouter free router) ----
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
LLM_MAX_TOKENS=500

# ---- Gmail (Python: signup / forgot-password OTP mails) ----
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_APP_PASSWORD=your-app-password

# ---- Node / Fastify ----
FASTIFY_PORT=3001
FASTIFY_CORS_HOST_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
FASTIFY_NODE_ENV=development

# ---- WhatsApp behaviour (Node) ----
MAX_SESSIONS=10                # max WhatsApp sockets at the same time
HISTORY_SIZE=20                # how many earlier messages of a chat go to the AI with the new one
REPLY_DEBOUNCE_MS=2000         # wait this long after the last message so 3 quick texts get ONE reply
CONTACT_RATE_LIMIT_PER_MIN=5   # a contact sending more than this per minute is ignored
